# Copy to .env and fill in. Never commit .env.

# PayPal Sandbox app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Claude API (console.anthropic.com). Empty = the purchasing agent stays off; everything else works.
ANTHROPIC_API_KEY=
# Optional: another Claude model for the agent (default claude-opus-5-5), and how often it checks
# the greenhouses in minutes (default 15; 0 = only when the manager runs it by hand).
AGENT_MODEL=
AGENT_INTERVAL_MINUTES=

# Postgres connection string (Render). Empty = local PGlite database in server/.data
DATABASE_URL=

# Key of the demo ESP32 (random, 24+ characters). Put the same value in
# firmware/Invernadero/secrets.h. Changing it here and restarting rotates it.
DEVICE_API_KEY=

# Password of the four demo users (10+ characters). Public on purpose: it goes in the
# README for the judges. Changing it here and restarting rotates it.
DEMO_PASSWORD=
