# Copy to .env and fill in. Never commit .env.

# PayPal Sandbox app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres connection string (Supabase)
DATABASE_URL=

# Shared secret the ESP32 sends with every reading
DEVICE_API_KEY=
